QMainWindow {
    background-color: #1a1a1a;
}

QWidget {
    background-color: #1a1a1a;
    color: #ffffff;
    font-family: "Segoe UI";
    font-size: 13px;
}

QPushButton {
    background-color: #2d2d2d;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #3d3d3d;
}

QPushButton:pressed {
    background-color: #0078d4;
}

QPushButton#shuffleButton[active="true"],
QPushButton#repeatAllButton[active="true"],
QPushButton#repeatOneButton[active="true"] {
    background-color: #0078d4;
}

QTreeWidget {
    background-color: #1a1a1a;
    border: none;
    color: #ffffff;
}

QTreeWidget::item:selected {
    background-color: #0078d4;
}

QHeaderView::section {
    background-color: #2d2d2d;
    color: #ffffff;
    border: none;
    padding: 4px;
}

QSlider#progressSlider::sub-page:horizontal {
    background-color: #0078d4;
    border-radius: 2px;
}

QSlider#progressSlider::add-page:horizontal {
    background-color: #2d2d2d;
    border-radius: 2px;
}

QSlider::groove:horizontal {
    background-color: #2d2d2d;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #ffffff;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: -4px 0;
}

QLineEdit {
    background-color: #2d2d2d;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

QMenuBar {
    background-color: #1a1a1a;
    color: #ffffff;
}

QMenuBar::item:selected {
    background-color: #2d2d2d;
}

QMenu {
    background-color: #2d2d2d;
    color: #ffffff;
    border: none;
}

QMenu::item:selected {
    background-color: #0078d4;
}